<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Camera permission is required only when the user chooses to attach a receipt photo.
        We declare it as optional so the app can still run on devices without a camera.
    -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
        Modern storage permission for API 33+ (Android 13 and higher).
        READ_MEDIA_IMAGES is used because the app only accesses photos (receipt images).
        This replaces the deprecated READ_EXTERNAL_STORAGE and WRITE_EXTERNAL_STORAGE.
        For devices on API 32 and below, the system falls back gracefully.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!--
        Hardware feature declaration for camera.
        This directly resolves the lint warning "Permission exists without corresponding hardware <uses-feature> tag".
        The feature is not required (required="false") so the app works on devices without a camera.
    -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HarmonieBudgetAppKt"
        tools:targetApi="36">

        <!--
            Main login screen - this is the launcher activity.
            The redundant label warning is resolved by keeping only the app-level label here.
            All other activities inherit the label from the application tag.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Register screen with full form: Name, Surname, Username, Password, Confirm Password -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false" />

        <!-- Category management screen -->
        <activity
            android:name=".CategoryActivity"
            android:exported="false" />

        <!-- Expense entry screen (amount, date, description, category, optional photo) -->
        <activity
            android:name=".ExpenseActivity"
            android:exported="false" />

        <!-- Goal setting screen (minimum and maximum monthly goals) -->
        <activity
            android:name=".GoalActivity"
            android:exported="false" />

        <!-- Expense list screen with photo viewing support -->
        <activity
            android:name=".ExpenseListActivity"
            android:exported="false" />

        <!-- Category totals screen -->
        <activity
            android:name=".CategoryTotalActivity"
            android:exported="false" />

    </application>

</manifest>