<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.HarmonieBudget" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorSecondary">@color/teal_200</item>

        <item name="android:windowBackground">@color/background_dark</item>

        <!--
            Explicit text color definitions for dark theme.
            These ensure all text elements remain visible and readable
            when the device is in dark mode. Light colors are used for
            maximum contrast against dark backgrounds.
        -->
        <item name="android:textColor">@color/text_primary_dark</item>
        <item name="android:textColorPrimary">@color/text_primary_dark</item>
        <item name="android:textColorSecondary">@color/text_secondary_dark</item>
        <item name="android:textColorHint">@color/text_hint_dark</item>

        <item name="colorControlNormal">@color/text_secondary_dark</item>
        <item name="colorControlActivated">@color/accent_blue</item>
        <item name="colorButtonNormal">@color/button_background_standard</item>

        <item name="cardViewStyle">@style/CardViewDark</item>

    </style>

    <style name="CardViewDark" parent="CardView">
        <item name="cardBackgroundColor">@color/surface_dark</item>
        <item name="cardElevation">1dp</item>
        <item name="cardCornerRadius">12dp</item>
    </style>

    <style name="StandardButton" parent="Widget.MaterialComponents.Button">
        <item name="android:backgroundTint">@color/button_background_standard</item>
        <item name="android:textColor">@color/button_text_standard</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="SecondaryButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:backgroundTint">@color/button_secondary_background</item>
        <item name="android:textColor">@color/button_secondary_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">48dp</item>
    </style>

</resources>