<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Night (dark) theme for the application.
        This file is located in the values-night folder so the Android resource system automatically loads it when the device is in dark mode.
        It uses the exact same style name as the light theme so the system can override only the colors that differ.
        This prevents any duplicate style error during resource merging.
        The parent and structure match the light theme for consistency.
    -->
    <style name="Theme.HarmonieBudget" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Primary brand color used for buttons and accents in dark mode -->
        <item name="colorPrimary">@color/purple_200</item>

        <!-- Status bar color in dark mode -->
        <item name="colorPrimaryVariant">@color/purple_700</item>

        <!-- Secondary brand color used for secondary elements in dark mode -->
        <item name="colorSecondary">@color/teal_700</item>

        <!-- Background color for all screens in dark mode -->
        <item name="android:windowBackground">@color/black</item>

        <!-- Default text color for dark backgrounds -->
        <item name="android:textColor">@android:color/white</item>

    </style>

</resources>