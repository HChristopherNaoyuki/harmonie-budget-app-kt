<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon background for the application launcher icon.
    The background is a solid black color as required by the branding specification.
    This file works in conjunction with ic_launcher_foreground.xml which contains
    the white letter H. The combination creates a black background with a white H.

    The path fills the entire 108dp x 108dp canvas.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#000000"
        android:pathData="M0,0h108v108h-108z" />

</vector>