<?xml version="1.0" encoding="utf-8"?>
<!--
    Minimalistic app icon foreground featuring the letter H.
    Uses a clean black background with a white letter H centered.
    The design follows the minimalist philosophy with no gradients or complex shapes.
    All dimensions are based on the standard 108dp x 108dp adaptive icon canvas.

    Updated for branding consistency: The letter H replaces the previous MB monogram.
    The black background requirement is satisfied by the ic_launcher_background file.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        Letter H path.
        Drawn with clean straight lines using a geometric sans-serif style.
        The letter is centered within the canvas for balanced visual appearance.
        Stroke width and positioning are proportional to the 108dp canvas.
        White color provides high contrast against the black background.
    -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="
            M 30,25
            L 30,83
            L 42,83
            L 42,59
            L 66,59
            L 66,83
            L 78,83
            L 78,25
            L 66,25
            L 66,49
            L 42,49
            L 42,25
            Z" />

</vector>