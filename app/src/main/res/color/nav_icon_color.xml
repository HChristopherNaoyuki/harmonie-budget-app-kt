<?xml version="1.0" encoding="utf-8"?>
<!--
    Color selector for bottom navigation icons.
    The selector applies a blue tint when the item is selected
    and a gray tint when it is not selected.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/accent_blue" android:state_checked="true"/>
    <item android:color="@color/text_secondary_light"/>
</selector>