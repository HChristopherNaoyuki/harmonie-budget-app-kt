<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Light theme for the application.
        This is the base theme referenced by AndroidManifest.xml.
        It inherits from Theme.MaterialComponents.DayNight.NoActionBar to ensure a clean, minimalistic look with no system action bar.
        All activities manage their own navigation, so NoActionBar is required.
        This file defines the style exactly once.
    -->
    <style name="Theme.HarmonieBudget" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Primary brand color used for buttons and accents -->
        <item name="colorPrimary">@color/purple_500</item>

        <!-- Status bar color in light mode -->
        <item name="colorPrimaryVariant">@color/purple_700</item>

        <!-- Secondary brand color used for secondary elements -->
        <item name="colorSecondary">@color/teal_200</item>

        <!-- Background color for all screens (white for light mode) -->
        <item name="android:windowBackground">@color/white</item>

        <!-- Default text color for light backgrounds -->
        <item name="android:textColor">@android:color/black</item>

    </style>

</resources>