
<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Base application theme.
        Corrected style name to exactly match the manifest reference (@style/Theme.HarmonieBudgetAppKt).
        Parent updated to a clean, modern Material theme (no DarkActionBar for minimal Apple-like feel).
        Colors kept from colors.xml for consistency.
        Up-to-date as of Android 14+ MaterialComponents (2026 standards).
    -->
    <style name="Theme.HarmonieBudgetAppKt" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color (clean blue for modern budgeting app). -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@android:color/white</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorSecondaryVariant">@color/colorAccent</item>
        <item name="colorOnSecondary">@android:color/black</item>

        <!-- Status bar color (matches primary variant). -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>

        <!-- Customize your theme here (light status bar for clean look). -->
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>