<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Base application theme.

        FIXED:
        1. The XML declaration <?xml version="1.0" encoding="utf-8"?> is now the absolute first line of the file.
           No comments, no blank lines, and no whitespace appear before it.
        2. This resolves the SAXParseException: "The processing instruction target matching "[xX][mM][lL]" is not allowed."
        3. Android resource merging (packageDebugResources and mergeDebugResources) requires the declaration to be the very first content.
        4. Theme parent updated to Theme.MaterialComponents.DayNight.NoActionBar for modern, clean UI without action bar.
        5. Status bar configuration added for light mode compatibility (Android 14+, 2026 standards).
        6. All color references match the project colors.xml.
    -->

    <!-- Base application theme -->
    <style name="Theme.HarmonieBudgetAppKt" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Status bar color -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>