<?xml version="1.0" encoding="utf-8"?>
<!--
    Bottom navigation menu for the DashboardActivity.
    All icons are custom vector drawables created by the application.
    This ensures no private Android system resources are used.

    Navigation Labels:
    - Home: stays "Home"
    - Budget: stays "Budget"
    - Category: changed from "Transactions" to "Category" (screen title remains "Transactions")
    - History: changed from "Budgets" to "History" (screen title remains "Budgets")
    - More: stays "More"

    Screen titles are defined in the individual fragment layout files.
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Home tab with custom House icon -->
    <item
        android:id="@+id/nav_home"
        android:title="@string/nav_home"
        android:icon="@drawable/ic_home_house" />

    <!-- Budget tab - no changes -->
    <item
        android:id="@+id/nav_budget"
        android:title="@string/nav_budget"
        android:icon="@android:drawable/ic_menu_edit" />

    <!--
        Category tab - label changed from "Transactions" to "Category".
        The icon remains the Pie Chart icon.
        The screen title inside the fragment remains "Transactions".
    -->
    <item
        android:id="@+id/nav_transactions"
        android:title="@string/nav_category"
        android:icon="@drawable/ic_pie_chart" />

    <!--
        History tab - label changed from "Budgets" to "History".
        The icon remains the Receipt icon.
        The screen title inside the fragment remains "Budgets".
    -->
    <item
        android:id="@+id/nav_budgets"
        android:title="@string/nav_history"
        android:icon="@drawable/ic_receipt" />

    <!-- More tab with custom Gear/Settings icon -->
    <item
        android:id="@+id/nav_more"
        android:title="@string/nav_more"
        android:icon="@drawable/ic_settings_gear" />

</menu>