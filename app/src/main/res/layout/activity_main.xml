<?xml version="1.0" encoding="utf-8"?>
<!--
    Main activity layout (first window) with minimalistic design.
    All original views and identifiers are preserved.
    Uses a clean vertical layout with refined spacing and a restrained color palette.
    The background is light gray, and buttons use a simple hierarchy
    (filled primary, light secondary, transparent tertiary).
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FAFAFA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- Welcome title with increased prominence and minimal styling -->
        <TextView
            android:id="@+id/tv_welcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="80dp"
            android:text="@string/welcome_message"
            android:textColor="#1C1C1E"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- Primary action: filled accent button -->
        <Button
            android:id="@+id/btn_login"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="64dp"
            android:backgroundTint="#007AFF"
            android:minHeight="56dp"
            android:text="@string/login_button"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <!-- Secondary action: subtle light gray button -->
        <Button
            android:id="@+id/btn_register"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="#E5E5EA"
            android:minHeight="48dp"
            android:text="@string/register_button"
            android:textColor="#1C1C1E"
            android:textSize="14sp" />

        <!-- Tertiary action: transparent text button -->
        <Button
            android:id="@+id/btn_forgot_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="@android:color/transparent"
            android:minHeight="48dp"
            android:text="@string/forgot_password_button"
            android:textColor="#8E8E93"
            android:textSize="14sp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>