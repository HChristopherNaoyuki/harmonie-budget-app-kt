<?xml version="1.0" encoding="utf-8"?>
<!--
    Main activity layout (Landing Page) with polished minimalistic design.
    Uses a clean vertical layout with refined spacing and a restrained gray color palette.
    The background is light gray, and all buttons use the StandardButton style with
    black background and white text as required.

    All three buttons (LOG IN, REGISTER, FORGOT PASSWORD) have identical width,
    identical height, consistent typography, and maintain equal spacing.
    Scrolling is enabled via NestedScrollView to prevent content squishing
    on smaller screens and when accessibility text size settings are increased.

    All text strings reference resources in strings.xml for proper internationalization.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_light"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp"
        android:paddingTop="80dp"
        android:paddingBottom="48dp">

        <!-- App icon using the updated launcher foreground drawable -->
        <ImageView
            android:id="@+id/iv_app_icon"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/ic_launcher_foreground"
            android:contentDescription="@string/app_name"
            android:layout_marginBottom="24dp" />

        <!-- Welcome title with increased prominence and minimal styling -->
        <TextView
            android:id="@+id/tv_welcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/welcome_message"
            android:textColor="@color/text_primary_light"
            android:textSize="32sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <!-- Subtitle text for landing page -->
        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/landing_subtitle"
            android:textColor="@color/text_secondary_light"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_marginBottom="64dp" />

        <!--
            Primary action: LOG IN button.
            Uses StandardButton style with black background and white text.
            Width is set to match_parent so all three buttons have identical width.
            Height is controlled by minHeight in the style (48dp).
        -->
        <Button
            android:id="@+id/btn_login"
            style="@style/StandardButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/login_button" />

        <!--
            Secondary action: REGISTER button.
            Uses StandardButton style with black background and white text.
            Maintains identical width and height as the LOG IN button.
        -->
        <Button
            android:id="@+id/btn_register"
            style="@style/StandardButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/register_button" />

        <!--
            Tertiary action: FORGOT PASSWORD button.
            Uses StandardButton style with black background and white text.
            All three buttons have consistent styling as required.
        -->
        <Button
            android:id="@+id/btn_forgot_password"
            style="@style/StandardButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="0dp"
            android:text="@string/forgot_password_button" />

        <!-- Version indicator at bottom of landing page -->
        <TextView
            android:id="@+id/tv_version_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/version_indicator"
            android:textColor="@color/text_secondary_light"
            android:textSize="12sp"
            android:layout_marginTop="48dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>