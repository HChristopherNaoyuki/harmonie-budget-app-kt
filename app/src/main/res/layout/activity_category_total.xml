<?xml version="1.0" encoding="utf-8"?>
<!--
    Category Totals screen displaying pie chart visualization.
    This screen now displays the Pie Chart (swapped from Budgets).
    The RETURN HOME button remains at the bottom.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:paddingBottom="32dp">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/category_totals_title"
                android:textColor="@color/text_primary_light"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- Pie Chart Container -->
            <FrameLayout
                android:id="@+id/pie_container"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp" />

            <!-- Totals text display for category breakdown -->
            <TextView
                android:id="@+id/tv_totals"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary_light"
                android:textSize="16sp"
                android:layout_marginBottom="16dp" />

            <!-- RETURN HOME Button -->
            <Button
                android:id="@+id/btn_return_home"
                style="@style/StandardButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="@string/return_home" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>