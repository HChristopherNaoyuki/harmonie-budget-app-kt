<?xml version="1.0" encoding="utf-8"?>
<!--
    Category Totals screen displaying expense history table with filters.
    This layout uses a LinearLayout as the root with a ScrollView for scrolling content.
    The background attribute is applied directly to the root LinearLayout.
    The RETURN HOME button is positioned at the bottom of the scrollable content.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light">

    <!--
        ScrollView wraps all content to enable vertical scrolling on smaller displays.
        This prevents UI elements from being squished when content exceeds visible space.
        fillViewport ensures the ScrollView takes the full height of its parent.
    -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:paddingBottom="32dp">

            <!-- Category Totals Title -->
            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/category_totals_title"
                android:textColor="@color/text_primary_light"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- Total amount display -->
            <TextView
                android:id="@+id/tv_total_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/default_zar_amount"
                android:textColor="@color/text_primary_light"
                android:textSize="36sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/this_month_label"
                android:textColor="@color/text_secondary_light"
                android:textSize="14sp"
                android:layout_marginBottom="24dp" />

            <!-- Filter Expenses Section Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/surface_light"
                app:strokeColor="@color/border_light"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/filter_expenses_label"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary_light"
                        android:layout_marginBottom="16dp" />

                    <!-- Category Filter -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/category_label"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary_light"
                        android:layout_marginBottom="8dp" />

                    <Spinner
                        android:id="@+id/spinner_filter_category"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/spinner_dropdown_background"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp" />

                    <!-- Date Filter Row with Clear Button -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/date_label"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary_light"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/til_filter_date"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="12dp"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            app:boxBackgroundColor="@color/surface_light"
                            app:boxStrokeColor="@color/accent_blue">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_filter_date"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/select_date_hint"
                                android:textSize="14sp"
                                android:focusable="false"
                                android:focusableInTouchMode="false"
                                android:clickable="true" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <Button
                            android:id="@+id/btn_clear_filter"
                            style="@style/SecondaryButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/clear_button"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_apply_filter"
                        style="@style/StandardButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/apply_filter_button" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Expense History Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/expense_history_label"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary_light"
                android:layout_marginBottom="12dp" />

            <!--
                RecyclerView for expense history entries.
                nestedScrollingEnabled=false allows the ScrollView to handle scrolling.
            -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_expense_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:nestedScrollingEnabled="false" />

            <!-- RETURN HOME Button at bottom of scrollable content -->
            <Button
                android:id="@+id/btn_return_home"
                style="@style/StandardButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="@string/return_home" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>