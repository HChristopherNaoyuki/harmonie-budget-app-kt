<?xml version="1.0" encoding="utf-8"?>
<!--
    Category Totals screen displaying totals table.
    Updated to match the mockup with a clean table format.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light"
    android:padding="20dp"
    android:paddingBottom="32dp">

    <!-- Back arrow navigation -->
    <TextView
        android:id="@+id/iv_back_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/back_arrow"
        android:textSize="16sp"
        android:textColor="@color/accent_blue"
        android:padding="8dp"
        android:layout_marginBottom="8dp"
        android:clickable="true"
        android:focusable="true" />

    <!-- Screen Title -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/category_totals_title"
        android:textColor="@color/text_primary_light"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Totals Table Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface_light"
        android:padding="16dp"
        android:layout_marginBottom="24dp">

        <!-- Table Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="12dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:text="@string/table_header_category"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary_light" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/table_header_amount"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary_light"
                android:gravity="end" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/table_header_percentage"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary_light"
                android:gravity="end" />

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_light"
            android:layout_marginBottom="8dp" />

        <!-- Dynamic Table Rows Container -->
        <LinearLayout
            android:id="@+id/table_rows_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

    <!-- RETURN HOME Button -->
    <Button
        android:id="@+id/btn_return_home"
        style="@style/StandardButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/return_home" />

</LinearLayout>