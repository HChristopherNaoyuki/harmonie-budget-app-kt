<?xml version="1.0" encoding="utf-8"?>
<!--
    Category Totals screen displaying expense history table with filters.
    This layout has been updated to visually match the provided mockup design.
    Currency label updated to use ZAR (South African Rand).

    Changes made to match the mockup:
    - Added a prominent total amount display at the top with ZAR currency
    - Restructured filter section with cleaner spacing and alignment
    - Added a dedicated scrollable container for Expense History entries
    - Updated typography, colors, and spacing to match the minimalist design
    - Used a RecyclerView within a scrollable parent for expense history

    All existing functionality, logic, and event handling remain unchanged.
    Only visual presentation has been modified.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingBottom="32dp">

        <!--
            Category Totals Title and Total Amount Section
            Matches the mockup which shows "Category Totals" followed by a large total amount.
        -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/category_totals_title"
            android:textColor="@color/text_primary_light"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!--
            Total amount display using string resource for default text.
            The actual value is populated programmatically by the activity.
            Format example: "R 2,847.35"
        -->
        <TextView
            android:id="@+id/tv_total_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/default_zar_amount"
            android:textColor="@color/text_primary_light"
            android:textSize="36sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/this_month_label"
            android:textColor="@color/text_secondary_light"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <!--
            Filter Expenses Section Card
            Matches the mockup which shows a card with "Filter Expenses" header,
            Category dropdown, Date picker with Clear button, and Apply Filter button.
        -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/surface_light"
            app:strokeColor="@color/border_light"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_expenses_label"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary_light"
                    android:layout_marginBottom="16dp" />

                <!-- Category Filter -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/category_label"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary_light"
                    android:layout_marginBottom="8dp" />

                <Spinner
                    android:id="@+id/spinner_filter_category"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/spinner_dropdown_background"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />

                <!-- Date Filter Row with Clear Button -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/date_label"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary_light"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_filter_date"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="12dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        app:boxBackgroundColor="@color/surface_light"
                        app:boxStrokeColor="@color/accent_blue">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_filter_date"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/select_date_hint"
                            android:textSize="14sp"
                            android:focusable="false"
                            android:focusableInTouchMode="false"
                            android:clickable="true" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Clear button matching mockup style -->
                    <Button
                        android:id="@+id/btn_clear_filter"
                        style="@style/SecondaryButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/clear_button"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp" />
                </LinearLayout>

                <!-- Apply Filter Button matching mockup -->
                <Button
                    android:id="@+id/btn_apply_filter"
                    style="@style/StandardButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/apply_filter_button" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!--
            Expense History Section with Scrollable Container
            Matches the mockup which shows a list of expense entries.
            The RecyclerView provides native scrolling for the expense history list.
        -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/expense_history_label"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary_light"
            android:layout_marginBottom="12dp" />

        <!--
            Scrollable container for expense history.
            The RecyclerView handles scrolling naturally when content exceeds available space.
            Each entry is displayed as a row showing category, description, amount, and date.
        -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_expense_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:nestedScrollingEnabled="true" />

        <!--
            RETURN HOME Button matching the mockup design.
            Positioned at the bottom of the scrollable content.
        -->
        <Button
            android:id="@+id/btn_return_home"
            style="@style/StandardButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="@string/return_home" />

    </LinearLayout>
</LinearLayout>