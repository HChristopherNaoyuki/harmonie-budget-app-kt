<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout for a single expense history item in the RecyclerView.
    Displays complete expense details including:
    - Category and description
    - Amount (ZAR currency, negative value in red)
    - Transaction date
    - Start time and end time
    - Submission date
    - Photo preview button when receipt exists

    Padding is defined symmetrically for Start and End to support right-to-left layouts.
    String resources are used for all user-facing text.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/surface_light"
    app:strokeColor="@color/border_light"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <!-- Row 1: Category and Description with Amount -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_category_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary_light"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <!-- Transaction Date (date of the expense) -->
                <TextView
                    android:id="@+id/tv_transaction_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary_light"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <!-- Amount (negative value in red) -->
            <TextView
                android:id="@+id/tv_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingStart="16dp"
                android:paddingEnd="0dp"
                android:gravity="end" />

        </LinearLayout>

        <!-- Row 2: Time Details (Start Time and End Time) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tv_start_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:textColor="@color/text_secondary_light" />

            <TextView
                android:id="@+id/tv_end_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:textColor="@color/text_secondary_light"
                android:gravity="end" />

        </LinearLayout>

        <!-- Row 3: Submission Date (when the expense was recorded) -->
        <TextView
            android:id="@+id/tv_submission_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/text_secondary_light"
            android:layout_marginTop="8dp" />

        <!--
            Row 4: Photo Preview Button (visible only if photo exists)
            Uses string resource for button text to support internationalization.
        -->
        <Button
            android:id="@+id/btn_view_receipt"
            style="@style/SecondaryButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="8dp"
            android:text="@string/view_receipt_button"
            android:visibility="gone"
            android:minHeight="32dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="11sp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>