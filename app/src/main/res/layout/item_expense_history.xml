<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout for a single expense history item in the RecyclerView.
    This layout matches the mockup design showing:
    - Category and description on the left (e.g., "Groceries - Whole Foods")
    - Amount on the right (e.g., "-$87.42")
    - Relative date below the category description (e.g., "Today")

    The layout uses a vertical LinearLayout for the left side content
    and a right-aligned TextView for the amount.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:background="?android:attr/selectableItemBackground">

    <!-- Left side: Category and description with relative date below -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_category_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary_light"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/text_secondary_light"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <!-- Right side: Amount (negative value in red) -->
    <TextView
        android:id="@+id/tv_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold"
        android:paddingStart="16dp"
        android:gravity="end" />

</LinearLayout>