<?xml version="1.0" encoding="utf-8"?>
<!--
    Register / Create Account screen with full scrolling capability.
    Uses ScrollView to ensure all input fields and buttons remain accessible
    on smaller screens. All fields are clearly labeled with a minimalist gray theme.

    Updated SIGN UP button to use StandardButton style with black background
    and white text as required.

    Added RETURN HOME button that navigates back to the Landing Page.
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="vertical"
    android:background="@color/background_light">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:paddingTop="48dp"
        android:paddingBottom="48dp"
        android:background="@color/background_light">

        <!-- Title - exact match to mock-up -->
        <TextView
            android:id="@+id/tv_register_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/create_new_account"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary_light"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Subtitle - blue and clickable, exact match to mock-up -->
        <TextView
            android:id="@+id/tv_already_registered"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/already_registered_log_in"
            android:textSize="14sp"
            android:textColor="@color/accent_blue"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tv_register_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- FULL NAME field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            app:boxBackgroundColor="@color/surface_light"
            app:boxStrokeColor="@color/accent_blue"
            app:boxStrokeWidth="1dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:layout_constraintTop_toBottomOf="@id/tv_already_registered"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/full_name_hint"
                android:textColor="@color/text_primary_light"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- USERNAME field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_username"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:boxBackgroundColor="@color/surface_light"
            app:boxStrokeColor="@color/accent_blue"
            app:boxStrokeWidth="1dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:layout_constraintTop_toBottomOf="@id/til_name"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_username"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/username_hint"
                android:textColor="@color/text_primary_light"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- PASSWORD field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_password"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:boxBackgroundColor="@color/surface_light"
            app:boxStrokeColor="@color/accent_blue"
            app:boxStrokeWidth="1dp"
            app:passwordToggleEnabled="true"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:layout_constraintTop_toBottomOf="@id/til_username"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/password_hint"
                android:inputType="textPassword"
                android:textColor="@color/text_primary_light"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- CONFIRM PASSWORD field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_confirm_password"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:boxBackgroundColor="@color/surface_light"
            app:boxStrokeColor="@color/accent_blue"
            app:boxStrokeWidth="1dp"
            app:passwordToggleEnabled="true"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:layout_constraintTop_toBottomOf="@id/til_password"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_confirm_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/confirm_password_hint"
                android:inputType="textPassword"
                android:textColor="@color/text_primary_light"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- USER ID label and display -->
        <TextView
            android:id="@+id/tv_user_id_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/user_id_label"
            android:textSize="14sp"
            android:textColor="@color/text_secondary_light"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/til_confirm_password"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tv_generated_user_id"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary_light"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tv_user_id_label"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Generate and copy User ID button -->
        <Button
            android:id="@+id/btn_generate_user_id"
            style="@style/StandardButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/generate_and_copy_user_id"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/tv_generated_user_id"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!--
            SIGN UP button with standardized black background and white text.
            Uses StandardButton style for consistency across the application.
        -->
        <Button
            android:id="@+id/btn_register"
            style="@style/StandardButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/sign_up_button"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/btn_generate_user_id"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!--
            RETURN HOME button added as required.
            Navigates back to the Landing Page (MainActivity).
            Uses StandardButton style for consistency.
        -->
        <Button
            android:id="@+id/btn_return_home"
            style="@style/StandardButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/return_home"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/btn_register"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>