<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="32dp">

    <!-- Title using string resource -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/set_monthly_goals"
        android:textSize="24sp"
        android:textColor="#000000"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="64dp" />

    <!-- Minimum goal SeekBar -->
    <SeekBar
        android:id="@+id/seek_min"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:max="10000"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp" />

    <!-- Minimum goal TextView -->
    <TextView
        android:id="@+id/tv_min_goal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/min_goal_text"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/seek_min"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp" />

    <!-- Maximum goal SeekBar -->
    <SeekBar
        android:id="@+id/seek_max"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:max="10000"
        app:layout_constraintTop_toBottomOf="@id/tv_min_goal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <!-- Maximum goal TextView -->
    <TextView
        android:id="@+id/tv_max_goal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/max_goal_text"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/seek_max"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp" />

    <!-- Save button -->
    <Button
        android:id="@+id/btn_save_goal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/btn_save_goals"
        android:backgroundTint="#000000"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/tv_max_goal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp" />

</androidx.constraintlayout.widget.ConstraintLayout>