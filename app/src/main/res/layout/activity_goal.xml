<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="#FFFFFF">

    <!-- Min Monthly Goal -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_min_goal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/hint_min_goal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_min_goal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Max Monthly Goal -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_max_goal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/hint_max_goal"
        app:layout_constraintTop_toBottomOf="@id/til_min_goal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_max_goal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Save Goals Button -->
    <Button
        android:id="@+id/btn_save_goal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/btn_save_goals"
        android:background="@drawable/rounded_button"
        app:layout_constraintTop_toBottomOf="@id/til_max_goal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp" />

</androidx.constraintlayout.widget.ConstraintLayout>