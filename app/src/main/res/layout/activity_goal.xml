<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="32dp"
    android:background="@color/white">

    <!--
        Title for the goal screen
        Matches the mockup image and User Interface.pdf minimalistic design.
    -->
    <TextView
        android:id="@+id/tv_goal_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/set_monthly_goals"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
        Minimum goal input
    -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_min_goal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/tv_goal_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_min_goal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_min_goal"
            android:inputType="numberDecimal" />
    </com.google.android.material.textfield.TextInputLayout>

    <!--
        Maximum goal input
    -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_max_goal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/til_min_goal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_max_goal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_max_goal"
            android:inputType="numberDecimal" />
    </com.google.android.material.textfield.TextInputLayout>

    <!--
        Save Goals button
    -->
    <Button
        android:id="@+id/btn_save_goals"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/btn_save_goals"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toBottomOf="@id/til_max_goal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
        Return Home button
        Required by the listed improvements for the Edit Budget page.
    -->
    <Button
        android:id="@+id/btn_return_home"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/return_home"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/btn_save_goals"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>