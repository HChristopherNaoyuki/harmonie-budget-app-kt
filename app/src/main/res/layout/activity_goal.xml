<?xml version="1.0" encoding="utf-8"?>
<!--
    Set Monthly Goals screen with minimalistic design.
    All original views and identifiers are preserved.
    Uses card-based grouping, refined spacing, and restrained typography.

    Fixed the RETURN HOME button functionality as required by Part 3.
    The button now correctly navigates back to the Home screen.
    Button styling standardized to black background with white text.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Title with increased prominence -->
        <TextView
            android:id="@+id/tv_goal_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/set_monthly_goals"
            android:textColor="@color/text_primary_light"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Input card containing both goal fields -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            app:cardBackgroundColor="@color/surface_light"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:text="@string/goal_details"
                    android:textAllCaps="true"
                    android:textColor="@color/text_secondary_light"
                    android:textSize="12sp" />

                <!-- Minimum goal input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_min_goal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxStrokeColor="@color/accent_blue">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_min_goal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_min_goal"
                        android:inputType="numberDecimal"
                        android:textColor="@color/text_primary_light"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Maximum goal input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_max_goal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxStrokeColor="@color/accent_blue">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_max_goal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_max_goal"
                        android:inputType="numberDecimal"
                        android:textColor="@color/text_primary_light"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Save Goals button with standardized black background -->
        <Button
            android:id="@+id/btn_save_goals"
            style="@style/StandardButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/btn_save_goals" />

        <!--
            RETURN HOME button with fixed functionality.
            Navigates directly to the Home screen and closes this activity.
            Uses standardized black background with white text.
            The button is now correctly implemented as required by Part 3.
        -->
        <Button
            android:id="@+id/btn_return_home"
            style="@style/StandardButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/return_home" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>