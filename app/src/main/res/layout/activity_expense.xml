<?xml version="1.0" encoding="utf-8"?>
<!--
    Add Expense screen layout with responsive scrolling for small screens.
    Uses NestedScrollView with LinearLayout to ensure all input fields and buttons
    remain accessible on small screens including 4.7 inch devices.
    All input fields use TextInputLayout for consistent Material Design appearance.
    The submit button and return home button are positioned at the bottom and
    remain visible within the scrollable area.

    Modified to add RETURN HOME button as required by Part 3 specifications.
    Button styling standardized to black background with white text.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_light"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="32dp">

        <!-- Title centered at the top of the form -->
        <TextView
            android:id="@+id/tv_expense_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:text="@string/add_expense_title"
            android:textColor="@color/text_primary_light"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Amount input field with numberDecimal input type -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:boxBackgroundColor="@color/surface_light"
            app:boxStrokeColor="@color/accent_blue"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_amount"
                android:inputType="numberDecimal"
                android:textColor="@color/text_primary_light"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Date input field with focusable=false to trigger DatePickerDialog -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:boxBackgroundColor="@color/surface_light"
            app:boxStrokeColor="@color/accent_blue"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_date"
                android:textColor="@color/text_primary_light"
                android:textSize="14sp"
                android:focusable="false"
                android:clickable="true"
                android:focusableInTouchMode="false" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Start Time input field with focusable=false to trigger TimePickerDialog -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_start_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:boxBackgroundColor="@color/surface_light"
            app:boxStrokeColor="@color/accent_blue"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_start_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_start_time"
                android:textColor="@color/text_primary_light"
                android:textSize="14sp"
                android:focusable="false"
                android:clickable="true"
                android:focusableInTouchMode="false" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- End Time input field with focusable=false to trigger TimePickerDialog -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_end_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:boxBackgroundColor="@color/surface_light"
            app:boxStrokeColor="@color/accent_blue"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_end_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_end_time"
                android:textColor="@color/text_primary_light"
                android:textSize="14sp"
                android:focusable="false"
                android:clickable="true"
                android:focusableInTouchMode="false" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Description input field for expense details -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:boxBackgroundColor="@color/surface_light"
            app:boxStrokeColor="@color/accent_blue"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_description"
                android:textColor="@color/text_primary_light"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Category spinner with dropdown background and fixed height -->
        <Spinner
            android:id="@+id/spinner_category"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/spinner_dropdown_background"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <!-- Attach Photo button with standardized black background -->
        <Button
            android:id="@+id/btn_attach_photo"
            style="@style/StandardButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/btn_attach_photo" />

        <!-- Submit button with standardized black background -->
        <Button
            android:id="@+id/btn_save_expense"
            style="@style/StandardButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/btn_save_expense" />

        <!--
            RETURN HOME button added as required by Part 3 specifications.
            Navigates directly to the Home screen when clicked.
            Uses the same standardized black background and white text styling.
            Positioned below the Submit button for logical flow.
        -->
        <Button
            android:id="@+id/btn_return_home"
            style="@style/StandardButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/return_home" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>