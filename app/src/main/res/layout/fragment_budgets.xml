<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="32dp"
    android:background="@color/white">

    <!--
        Title for the budgets tab
        Matches the mockup image and User Interface.pdf minimalistic design.
    -->
    <TextView
        android:id="@+id/tv_budgets_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/smart_detection"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!--
        RecyclerView for immediate display of all categories with 28-day totals
        (left-aligned names, right-aligned totals in one column)
        Required by the listed improvements for the Budgets Tab.
    -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_budgets"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/tv_budgets_title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>