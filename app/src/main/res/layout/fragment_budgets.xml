<?xml version="1.0" encoding="utf-8"?>
<!--
    Budgets fragment layout for viewing category totals.
    Button styling standardized to black background with white text.
    Layout optimized for small screens using ConstraintLayout with proper constraints.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="32dp"
    android:background="@color/background_light">

    <TextView
        android:id="@+id/tv_budgets_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/smart_detection"
        android:textColor="@color/text_primary_light"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_budgets"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/tv_budgets_title"
        app:layout_constraintBottom_toTopOf="@id/btn_view_totals"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
        View Category Totals button with standardized black background.
        Uses StandardButton style for consistency across the application.
    -->
    <Button
        android:id="@+id/btn_view_totals"
        style="@style/StandardButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/view_category_totals"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>